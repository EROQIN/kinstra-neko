    "@deepseek-ai/dsh-workspace": "0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@types/node": "^22.20.0",
    "@types/qrcode-generator": "^0.0.16",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
